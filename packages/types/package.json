{
  "name": "@metaswarm-dashboard/types",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./snapshots": {
      "types": "./dist/snapshots.d.ts",
      "import": "./dist/snapshots.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    },
    "./fs-utils": {
      "types": "./dist/fs-utils.d.ts",
      "import": "./dist/fs-utils.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "import": "./dist/sessions.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
